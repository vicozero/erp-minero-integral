# Copiar a .env y completar valores locales. NO versionar .env.
# Para usar un perfil alternativo sin reemplazar .env, definir ERP_ENV_FILE
# apuntando a otro archivo (por ejemplo, .env.pilot).
APP_NAME=ERP MINERO INTEGRAL
ENV=local
API_V1_PREFIX=/api/v1
TIMEZONE=America/Mexico_City
ACCESS_TOKEN_EXPIRE_MINUTES=60

# El portal se sirve desde el mismo origen: CORS no es necesario.
# Dejar vacío en el piloto; los valores por defecto solo cubren Vite local.
# CORS_ALLOW_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# Host/Origen aceptados por la API. En intranet se sustituye por el FQDN autorizado.
# ALLOWED_HOSTS=127.0.0.1,localhost,testserver
# Host internos autorizados a reenviar X-Forwarded-Host/Proto; deben coincidir
# con el Host que el proxy envía al backend (ver PORTAL_BACKEND_URL).
# TRUSTED_PROXY_HOSTS=127.0.0.1:8000,localhost:8000
# Intervalo mínimo para persistir last_seen_at de una sesión (segundos).
# SESSION_LAST_SEEN_THROTTLE_SECONDS=60
SECURITY_HSTS_ENABLED=false

# Separación de funciones: el comprador no aprueba su propia orden de compra.
# No habilitar sin una matriz de aprobadores aprobada formalmente.
# ALLOW_PURCHASE_ORDER_SELF_APPROVAL=false

# Servidor web local (proxy inverso + estáticos). No cambiar a 0.0.0.0.
BACKEND_PORT=8000
PORTAL_HOST=127.0.0.1
PORTAL_PORT=8080
PORTAL_BACKEND_URL=http://127.0.0.1:8000
PORTAL_ALLOW_LAN=false
PORTAL_HTTPS=false
PORTAL_HSTS=false

# Cadena local de PostgreSQL. Reemplazar <password> por un valor generado localmente.
# Nunca versionar la contraseña real; .env está ignorado por Git.
DATABASE_URL=postgresql+psycopg://erp_minero_app:<password>@127.0.0.1:5432/erp_minero_dev

# Secreto local para firmar tokens. Generar uno propio, nunca usar este ejemplo.
SECRET_KEY=

# Contraseña ficticia única para las cuentas demo. No usar contraseñas reales.
DEMO_PASSWORD=

# API relativa: dejar vacío para que el portal compilado use el mismo origen.
# VITE_API_URL=
