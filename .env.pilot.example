# Perfil independiente para el piloto. Copiar a .env.pilot y completar valores.
# No reemplazar .env ni apuntar a erp_minero_dev, CONTPAQi ni datos reales.
APP_NAME=ERP MINERO INTEGRAL
ENV=pilot
API_V1_PREFIX=/api/v1
TIMEZONE=America/Mexico_City
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Base sintética creada previamente por un administrador de PostgreSQL.
# El rol erp_minero_app NO necesita CREATEDB.
DATABASE_URL=postgresql+psycopg://erp_minero_app:<password>@127.0.0.1:5432/erp_minero_pilot

# Generar valores propios; nunca versionar este archivo.
SECRET_KEY=<secreto-local-generado>
DEMO_PASSWORD=<contraseña-ficticia>

# El piloto se sirve desde el mismo origen: CORS no es necesario.
CORS_ALLOW_ORIGINS=
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax
SESSION_COOKIE_DOMAIN=
SECURITY_HSTS_ENABLED=false

# Portal local. Para intranet se cambiará de forma controlada y autorizada.
BACKEND_PORT=8000
PORTAL_HOST=127.0.0.1
PORTAL_PORT=8080
PORTAL_BACKEND_URL=http://127.0.0.1:8000
PORTAL_ALLOW_LAN=false
PORTAL_HTTPS=false
PORTAL_HSTS=false

# API relativa: dejar VITE_API_URL vacío para el build del portal.
VITE_API_URL=
