# Copiar a .env y completar valores locales. NO versionar .env.
APP_NAME=ERP MINERO INTEGRAL
ENV=local
API_V1_PREFIX=/api/v1
TIMEZONE=America/Mexico_City
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Cadena local de PostgreSQL. Ejemplo sin credenciales reales:
# DATABASE_URL=postgresql+psycopg://erp_local@127.0.0.1:5432/erp_minero
DATABASE_URL=

# Secreto local para firmar tokens. Generar uno propio, nunca usar este ejemplo.
SECRET_KEY=

# Contraseña ficticia única para las cuentas demo. No usar contraseñas reales.
DEMO_PASSWORD=

# URL de la API usada por el frontend (opcional; valor por defecto abajo).
# VITE_API_URL=http://127.0.0.1:8000
